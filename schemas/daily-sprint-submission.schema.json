{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opensat.local/schemas/daily-sprint-submission.schema.json",
  "title": "OpenSAT Visual Daily Sprint Submission",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "surface",
    "manifest_id",
    "session_id",
    "submission_id",
    "section",
    "answers",
    "actual_minutes",
    "fatigue",
    "reflection"
  ],
  "properties": {
    "schema_version": {"enum": ["1.0", "1.1", "1.2"]},
    "surface": {"const": "visualize"},
    "manifest_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "session_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "submission_id": {"type": "string", "minLength": 1, "maxLength": 192},
    "section": {
      "enum": ["diagnostic_core", "strategy_and_reflection"]
    },
    "answers": {
      "type": "array",
      "maxItems": 100
    },
    "actual_minutes": {"type": "integer", "minimum": 0, "maximum": 20},
    "fatigue": {"enum": [null, "low", "moderate", "high"]},
    "reflection": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["observed_fact", "uncertainty", "next_review"],
      "properties": {
        "observed_fact": {"type": "string", "minLength": 1, "maxLength": 1000},
        "uncertainty": {"type": "string", "minLength": 1, "maxLength": 1000},
        "next_review": {"type": "string", "minLength": 1, "maxLength": 1000}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"schema_version": {"const": "1.0"}}},
      "then": {"properties": {"answers": {"items": {"$ref": "#/$defs/legacy_answer"}}}}
    },
    {
      "if": {"properties": {"schema_version": {"const": "1.1"}}},
      "then": {"properties": {"answers": {"items": {"$ref": "#/$defs/timed_answer"}}}}
    },
    {
      "if": {"properties": {"schema_version": {"const": "1.2"}}},
      "then": {"properties": {"answers": {"items": {"$ref": "#/$defs/calibrated_answer"}}}}
    }
  ],
  "$defs": {
    "answer_properties": {
      "type": "object",
      "properties": {
        "item_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "selected_answer": {"type": ["string", "null"], "pattern": "^[A-D]$"},
        "confidence": {"type": "integer", "minimum": 1, "maximum": 5},
        "time_seconds": {"type": "number", "minimum": 0, "maximum": 3600},
        "answer_changed": {"type": "boolean"},
        "almost_choice": {"type": ["string", "null"], "pattern": "^[A-D]$"},
        "help_used": {"type": "boolean"}
      }
    },
    "legacy_answer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id",
        "selected_answer",
        "confidence",
        "time_seconds",
        "answer_changed",
        "almost_choice",
        "help_used"
      ],
      "properties": {
        "item_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "selected_answer": {"type": ["string", "null"], "pattern": "^[A-D]$"},
        "confidence": {"type": "integer", "minimum": 1, "maximum": 5},
        "time_seconds": {"type": "number", "minimum": 0, "maximum": 3600},
        "answer_changed": {"type": "boolean"},
        "almost_choice": {"type": ["string", "null"], "pattern": "^[A-D]$"},
        "help_used": {"type": "boolean"}
      }
    },
    "timed_answer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id",
        "selected_answer",
        "confidence",
        "time_seconds",
        "answer_changed",
        "almost_choice",
        "help_used",
        "timing_source",
        "timer_state"
      ],
      "properties": {
        "item_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "selected_answer": {"type": ["string", "null"], "pattern": "^[A-D]$"},
        "confidence": {"type": "integer", "minimum": 1, "maximum": 5},
        "time_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 3600},
        "answer_changed": {"type": "boolean"},
        "almost_choice": {"type": ["string", "null"], "pattern": "^[A-D]$"},
        "help_used": {"type": "boolean"},
        "timing_source": {"const": "visualize_monotonic_timer"},
        "timer_state": {"const": "stopped"}
      }
    },
    "calibrated_answer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id",
        "selected_answer",
        "confidence",
        "apparent_difficulty",
        "time_seconds",
        "answer_changed",
        "almost_choice",
        "help_used",
        "timing_source",
        "timer_state"
      ],
      "properties": {
        "item_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "selected_answer": {"type": ["string", "null"], "pattern": "^[A-D]$"},
        "confidence": {"type": "integer", "minimum": 1, "maximum": 5},
        "apparent_difficulty": {"enum": ["routine", "noticeable", "intimidating"]},
        "time_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 3600},
        "answer_changed": {"type": "boolean"},
        "almost_choice": {"type": ["string", "null"], "pattern": "^[A-D]$"},
        "help_used": {"type": "boolean"},
        "timing_source": {"const": "visualize_monotonic_timer"},
        "timer_state": {"const": "stopped"}
      }
    }
  }
}
